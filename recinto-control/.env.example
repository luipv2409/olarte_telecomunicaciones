# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA RECINTO-CONTROL (FASE 0 Y FASE 1)
# ==============================================================================

# Puerto host para el backend FastAPI y panel web
# Verifica previamente en PowerShell que no esté ocupado:
# Get-NetTCPConnection -LocalPort 8089 -ErrorAction SilentlyContinue
HOST_HTTP_PORT=8089

# IP a vincular en el host (127.0.0.1 para acceso local seguro, o 0.0.0.0 para LAN)
HOST_BIND_IP=127.0.0.1

# ==============================================================================
# BASE DE DATOS POSTGRESQL (RED INTERNA AISLADA DOCKER)
# La base de datos NO se publica al host exterior para evitar conflictos de puerto
# ==============================================================================
POSTGRES_DB=recinto_control_db
POSTGRES_USER=recinto_admin
POSTGRES_PASSWORD=recinto_secure_pass_cambiar_en_produccion
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# ==============================================================================
# SEGURIDAD Y TOKENS DE DISPOSITIVO (ESP32-S3)
# ==============================================================================
# Token compartido que el firmware ESP32 debe enviar en la cabecera X-Device-Token
DEVICE_API_SECRET=esp32_device_secret_token_seguro_fase1

# ==============================================================================
# DIRECCIÓN DEL ESP32-S3 (PARA MONITOREO DE CÁMARA EN FASE 5)
# ==============================================================================
ESP32_BASE_URL=http://192.168.1.111

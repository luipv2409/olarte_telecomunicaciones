#ifndef SECRETS_H
#define SECRETS_H

// ==============================================================================
// PLANTILLA DE SECRETOS PARA FIRMWARE ESP32-S3 (FASE 1)
// Copia este archivo como "secrets.h" e introduce tus valores locales reales.
// NUNCA subas "secrets.h" con tus credenciales a repositorios públicos.
// ==============================================================================

// Credenciales Wi-Fi (red 2.4 GHz)
#define SECRET_WIFI_SSID     "TU_SSID_WIFI"
#define SECRET_WIFI_PASSWORD "TU_PASSWORD_WIFI"

// Token de autenticación del dispositivo hacia el backend FastAPI
// Debe coincidir exactamente con DEVICE_API_SECRET en el archivo .env del servidor
#define SECRET_DEVICE_TOKEN  "esp32_device_secret_token_seguro_fase1"

// URL base del backend FastAPI en tu PC Windows (ejemplo: http://192.168.1.50:8089)
// Recuerda: el ESP32 no puede resolver "localhost"; debes usar la IP local de tu PC en la LAN
#define BACKEND_BASE_URL     "http://192.168.1.50:8089"

#endif // SECRETS_H

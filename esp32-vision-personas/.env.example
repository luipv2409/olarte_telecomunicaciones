# ==============================================================================
# CONFIGURACIÓN OBLIGATORIA DE RED Y PUERTO (DOCKER)
# ==============================================================================
# APP_BIND_IP:
#   - Usa '127.0.0.1' para acceso exclusivo desde esta PC.
#   - Usa la IP local de tu PC (ej. 192.168.1.25) si deseas acceder desde otros dispositivos en tu LAN.
APP_BIND_IP=127.0.0.1

# APP_HOST_PORT:
#   - Puerto libre en tu PC Windows para el panel web y la API.
#   - Verifica antes que esté libre ejecutando en PowerShell:
#     Get-NetTCPConnection -LocalPort 8088 -ErrorAction SilentlyContinue
APP_HOST_PORT=8088

# ==============================================================================
# CONFIGURACIÓN DE LA CÁMARA ESP32-S3
# ==============================================================================
# Dirección base HTTP de la cámara (mostrada en el monitor serie de Arduino al conectar a WiFi)
# Ejemplo: http://192.168.1.150
ESP32_BASE_URL=http://192.168.1.150

# Intervalo entre capturas periódicas en segundos (mínimo 1.0 s para estabilidad térmica)
CAPTURE_INTERVAL_SECONDS=2.0

# Umbral de confianza para detección de personas con YOLO (entre 0.10 y 0.95)
DETECTION_CONFIDENCE=0.45

# ==============================================================================
# CONFIGURACIÓN DE DEEPSEEK (OPCIONAL - VISIÓN MULTIMODAL)
# ==============================================================================
# Clave de API de DeepSeek (dejar vacía si no se desea usar análisis en la nube)
DEEPSEEK_API_KEY=

# Modelo con capacidad de visión en la API oficial de DeepSeek (ej. deepseek-flash)
DEEPSEEK_MODEL=deepseek-flash

# Habilitar integración de visión (true/false).
# Deshabilitado por defecto para evitar consumo no deseado de tokens o salida a internet.
DEEPSEEK_VISION_ENABLED=false
